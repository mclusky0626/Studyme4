# Discord Developer Portal에서 발급. 절대 커밋하지 마세요.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
WAKE_WORD=스터디미야

# PostgreSQL / Redis
DATABASE_URL=postgresql+asyncpg://studyme:studyme@localhost:5432/studyme
REDIS_URL=redis://localhost:6379/0

# openai | gemini | grok | fake
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GROK_API_KEY=
GROK_CHAT_MODEL=grok-3-mini

BOT_NAME=미유
# 긴 페르소나는 이 UTF-8 파일을 편집하세요. 비우면 BOT_PERSONA를 사용합니다.
BOT_PERSONA_FILE=persona.md
BOT_PERSONA=친근하고 간결한 한국어 반말을 쓰되 AI임을 숨기지 않는다.
MEMORY_EXTRACTION_ENABLED=true
AUTO_PARTICIPATION_ENABLED=true
# llm: 기존 대화 모델 / ollama: 로컬 소형 모델 / off: 명시 호출만 응답
PARTICIPATION_JUDGE_PROVIDER=llm
PARTICIPATION_REPLY_THRESHOLD=0.78
PARTICIPATION_REACT_THRESHOLD=0.72
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_PARTICIPATION_MODEL=qwen2.5:3b
RESPONSE_MAX_BUBBLES=4
RESPONSE_BUBBLE_MAX_CHARS=700
RUN_BOT=true
HEALTH_HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
